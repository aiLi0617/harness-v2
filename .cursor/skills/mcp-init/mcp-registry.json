{
  "$schema": "./mcp-registry.schema.json",
  "version": "1.0.0",
  "defaults": ["codegraph", "ONES", "loki-mcp"],
  "servers": {
    "codegraph": {
      "label": "CodeGraph 代码知识图谱",
      "repo": "https://github.com/colbymchenry/codegraph",
      "transport": "stdio",
      "prerequisites": ["codegraph CLI"],
      "install": {
        "windows": "irm https://raw.githubusercontent.com/colbymchenry/codegraph/main/install.ps1 | iex",
        "unix": "curl -fsSL https://raw.githubusercontent.com/colbymchenry/codegraph/main/install.sh | sh"
      },
      "postInstall": ["codegraph init"],
      "config": {
        "type": "stdio",
        "command": "codegraph",
        "args": ["serve", "--mcp", "--path", "${workspaceFolder}"]
      }
    },
    "ONES": {
      "label": "ONES 项目管理 / Wiki",
      "repo": "https://sz.ones.cn/mcp",
      "transport": "http",
      "prerequisites": ["ONES 账号；Cursor Settings → MCP 完成 OAuth"],
      "install": {
        "all": "无需安装 CLI；fixedEnv.ONES_MCP_URL=https://sz.ones.cn/mcp，Cursor 内授权即可"
      },
      "config": {
        "url": "{{ONES_MCP_URL}}"
      },
      "envDefaults": {
        "ONES_MCP_URL": "https://sz.ones.cn/mcp"
      }
    },
    "feishu-cli": {
      "label": "飞书 Lark CLI（终端 + Skills，非 MCP）",
      "repo": "https://github.com/larksuite/cli",
      "transport": "none",
      "prerequisites": ["Node.js 18+", "lark-cli config init", "lark-cli auth login --recommend"],
      "install": {
        "all": "npx @larksuite/cli@latest install"
      },
      "postInstall": [
        "npx skills add larksuite/cli -g -y",
        "lark-cli config init",
        "lark-cli auth login --recommend"
      ],
      "notes": "官方 CLI 无 MCP 传输层；Agent 通过终端 lark-cli + lark-* Skills 操作飞书"
    },
    "loki-mcp": {
      "label": "Grafana Loki 日志查询",
      "repo": "https://github.com/grafana/loki-mcp",
      "transport": "stdio",
      "prerequisites": ["已编译的 loki-mcp 二进制；在 mcp.config.json → tools.LOKI_MCP_BIN 配置路径"],
      "install": {
        "windows": "使用已有 loki-mcp.exe，或 go install github.com/grafana/loki-mcp/cmd/mcp@latest",
        "unix": "go install github.com/grafana/loki-mcp/cmd/mcp@latest",
        "notes": "仓库 https://github.com/grafana/loki-mcp；stdio 模式 LOKI_URL 指向 Loki 后端"
      },
      "alternatives": {
        "http-bridge": {
          "url": "{{LOKI_MCP_URL}}"
        },
        "stdio-docker": {
          "command": "docker",
          "args": [
            "run", "--rm", "-i",
            "-e", "LOKI_URL={{LOKI_URL}}",
            "-e", "LOKI_ORG_ID={{LOKI_ORG_ID}}",
            "-e", "LOKI_USERNAME={{LOKI_USERNAME}}",
            "-e", "LOKI_PASSWORD={{LOKI_PASSWORD}}",
            "loki-mcp-server:latest"
          ]
        }
      },
      "config": {
        "command": "{{LOKI_MCP_BIN}}",
        "args": [],
        "env": {
          "LOKI_URL": "{{LOKI_URL}}",
          "LOKI_ORG_ID": "{{LOKI_ORG_ID}}",
          "LOKI_USERNAME": "{{LOKI_USERNAME}}",
          "LOKI_PASSWORD": "{{LOKI_PASSWORD}}",
          "LOKI_TOKEN": "{{LOKI_TOKEN}}"
        }
      },
      "envDefaults": {
        "LOKI_URL": "http://127.0.0.1:3100"
      },
      "envKeys": ["LOKI_URL", "LOKI_ORG_ID", "LOKI_USERNAME", "LOKI_PASSWORD", "LOKI_TOKEN", "LOKI_MCP_BIN"],
      "notes": "Cursor 通过 stdio 启动 loki-mcp-server，LOKI_URL 指向 Loki 后端（dev: 192.168.3.25:3100）"
    },
    "mysql-mcp": {
      "label": "MySQL 数据库",
      "repo": "https://github.com/benborla/mcp-server-mysql",
      "transport": "stdio",
      "prerequisites": ["Node.js 20+"],
      "install": {
        "all": "npx -y @benborla29/mcp-server-mysql（由 switch 脚本自动调用；首次会下载 npm 包）"
      },
      "config": {
        "command": "{{NPX_BIN}}",
        "args": ["-y", "@benborla29/mcp-server-mysql"],
        "env": {
          "MYSQL_HOST": "{{MYSQL_HOST}}",
          "MYSQL_PORT": "{{MYSQL_PORT}}",
          "MYSQL_USER": "{{MYSQL_USER}}",
          "MYSQL_PASS": "{{MYSQL_PASS}}",
          "MYSQL_DB": "{{MYSQL_DB}}"
        }
      },
      "envDefaults": {
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "3306"
      },
      "envKeys": ["MYSQL_HOST", "MYSQL_PORT", "MYSQL_USER", "MYSQL_PASS", "MYSQL_DB"],
      "notes": "写操作默认关闭；MYSQL_DB 留空=多库模式（dev/sit 均如此）；需 ALLOW_INSERT_OPERATION 等 env 显式开启"
    },
    "redis-mcp": {
      "label": "Redis",
      "repo": "https://github.com/redis/mcp-redis",
      "transport": "stdio",
      "prerequisites": ["uv（pip install uv）"],
      "install": {
        "all": "pip install uv && uvx --from redis-mcp-server redis-mcp-server --help"
      },
      "config": {
        "command": "{{UVX_BIN}}",
        "args": ["--from", "redis-mcp-server", "redis-mcp-server", "--url", "{{REDIS_URL}}"]
      },
      "envKeys": ["REDIS_URL"],
      "notes": "profile.env 设 REDIS_URL（含 db）；无 ACL 时用 redis://:password@host:port/db，勿写 root: 前缀；密码原文，> 勿 URL 编码（%3E 会导致认证失败）"
    },
    "elasticsearch-mcp": {
      "label": "Elasticsearch（官方 MCP）",
      "repo": "https://github.com/elastic/mcp-server-elasticsearch",
      "transport": "stdio",
      "prerequisites": ["Node.js 18+", "npx 或 Docker"],
      "install": {
        "npm": "npx -y @elastic/mcp-server-elasticsearch（推荐）",
        "docker": "docker run -i --rm -e ES_URL -e ES_API_KEY docker.elastic.co/mcp/elasticsearch stdio"
      },
      "config": {
        "command": "{{NPX_BIN}}",
        "args": ["-y", "@elastic/mcp-server-elasticsearch"],
        "env": {
          "ES_URL": "{{ES_URL}}",
          "ES_API_KEY": "{{ES_API_KEY}}",
          "ES_USERNAME": "{{ES_USERNAME}}",
          "ES_PASSWORD": "{{ES_PASSWORD}}",
          "ES_SSL_SKIP_VERIFY": "{{ES_SSL_SKIP_VERIFY}}",
          "ES_VERSION": "{{ES_VERSION}}",
          "OTEL_LOG_LEVEL": "none"
        }
      },
      "envDefaults": {
        "ES_URL": "http://localhost:9200"
      },
      "envKeys": [
        "ES_URL",
        "ES_API_KEY",
        "ES_USERNAME",
        "ES_PASSWORD",
        "ES_SSL_SKIP_VERIFY",
        "ES_VERSION"
      ],
      "notes": "【默认未启用】官方 @elastic/mcp-server-elasticsearch；加入 profiles.*.servers 并配置 ES_URL + 认证后 switch"
    },
    "xxl-job-mcp": {
      "label": "XXL-JOB 任务调度",
      "repo": "https://github.com/zz-wenzb/xxl-job-mcp",
      "transport": "stdio",
      "prerequisites": ["Python 3.9+", "uv"],
      "install": {
        "all": "uvx --with fastmcp==2.2.0 --from git+https://github.com/zz-wenzb/xxl-job-mcp xxl-job-mcp --help（未发布 PyPI；需 pin fastmcp 2.2.x，新版移除 description 参数）"
      },
      "config": {
        "command": "{{UVX_BIN}}",
        "args": [
          "--with",
          "fastmcp==2.2.0",
          "--from",
          "git+https://github.com/zz-wenzb/xxl-job-mcp",
          "xxl-job-mcp",
          "--config",
          "{{XXL_JOB_CONFIG_PATH}}"
        ]
      },
      "envKeys": [
        "XXL_JOB_ADMIN_ADDRESS",
        "XXL_JOB_USERNAME",
        "XXL_JOB_PASSWORD",
        "XXL_JOB_ACCESS_TOKEN",
        "XXL_JOB_CONFIG_PATH"
      ],
      "notes": "configurator 从 profile env 生成 .cursor/.generated/xxl-job-<profile>.yaml；支持 XXL-JOB 2.x"
    },
    "nacos-mcp-router": {
      "label": "Nacos MCP Router",
      "repo": "https://github.com/nacos-group/nacos-mcp-router",
      "transport": "stdio",
      "prerequisites": ["Python 3.9+ 或 Node 18+", "uv 或 npx"],
      "install": {
        "python": "uvx nacos-mcp-router@latest",
        "node": "npx nacos-mcp-router@latest"
      },
      "config": {
        "command": "{{UVX_BIN}}",
        "args": ["nacos-mcp-router@latest"],
        "env": {
          "NACOS_ADDR": "{{NACOS_ADDR}}",
          "NACOS_USERNAME": "{{NACOS_USERNAME}}",
          "NACOS_PASSWORD": "{{NACOS_PASSWORD}}",
          "NACOS_NAMESPACE": "{{NACOS_NAMESPACE}}"
        }
      },
      "envDefaults": {
        "NACOS_ADDR": "127.0.0.1:8848",
        "NACOS_USERNAME": "nacos",
        "NACOS_NAMESPACE": "public"
      },
      "envKeys": ["NACOS_ADDR", "NACOS_USERNAME", "NACOS_PASSWORD", "NACOS_NAMESPACE"],
      "notes": "Router 模式：search/add/use 代理 Nacos 注册的 MCP；search 返回空列表正常；NACOS_NAMESPACE 填 UUID 或 public"
    },
    "rocketmq-mcp": {
      "label": "RocketMQ 管理",
      "repo": "https://github.com/francisoliverlee/rocketmq-mcp",
      "transport": "http",
      "prerequisites": ["Java 17+", "需独立部署 rocketmq-mcp jar（SSE 6868）"],
      "install": {
        "all": "git clone https://github.com/francisoliverlee/rocketmq-mcp && cd rocketmq-mcp && ./build.sh && java -jar target/rocketmq-mcp-*.jar"
      },
      "config": {
        "url": "{{ROCKETMQ_MCP_URL}}"
      },
      "envDefaults": {
        "ROCKETMQ_MCP_URL": "http://127.0.0.1:6868/sse"
      },
      "envKeys": ["ROCKETMQ_MCP_URL"],
      "notes": "【默认未启用】Spring AI MCP SSE；jar 部署后配置 ROCKETMQ_MCP_URL，加入 profiles.*.servers 后 switch"
    }
  }
}
